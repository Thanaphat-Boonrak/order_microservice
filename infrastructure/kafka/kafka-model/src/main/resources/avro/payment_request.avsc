{
    "namespace": "com.thanaphat2005.food.ordering.system.kafka.order.avro.model",
    "type": "record",
    "name": "PaymentRequestAvroModel",
    "fields": [
        {
            "name": "id",
            "type": "string"
        },
        {
            "name": "sagaId",
            "type": "string"
        },
        {
            "name": "customerId",
            "type": "string"
        },
        {
            "name": "orderId",
            "type": "string"
        },
        {
            "name": "price",
            "type": {
                "type": "bytes",
                "logicalType": "decimal",
                "precision": 10,
                "scale": 2
            }
        },
        {
            "name": "createdAt",
            "type": {
                "type": "long",
                "logicalType": "timestamp-millis"
            }
        },
        {
            "name": "paymentOrderStatus",
            "type": {
                "type": "enum",
                "name": "PaymentOrderStatus",
                "symbols": ["PENDING", "CANCELLED"]
            }
        }
    ]
}